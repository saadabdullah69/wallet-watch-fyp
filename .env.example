# Copy this file to ".env" and fill it in.

# Web address of a blockchain node (get a free one from Alchemy, Infura, or QuickNode).
# Leave empty to run the website without live chain watching.
RPC_URL=

# Chain settings (defaults below are for Ethereum mainnet)
NATIVE_SYMBOL=ETH
COINGECKO_PLATFORM=ethereum
COINGECKO_NATIVE_ID=ethereum
# Optional: free demo key from coingecko.com (avoids rate limits)
COINGECKO_API_KEY=

# How often to check for new blocks, in milliseconds
POLL_MS=4000

# Website port
PORT=3000

# Set to 1 to enable the test endpoint that injects a fake event (for testing only)
DEV=0

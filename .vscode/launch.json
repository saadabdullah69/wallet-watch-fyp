{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Wallet Watch (press F5)",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/src/server.ts",
      "runtimeArgs": ["--env-file-if-exists=.env", "--import", "tsx"],
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"]
    }
  ]
}
